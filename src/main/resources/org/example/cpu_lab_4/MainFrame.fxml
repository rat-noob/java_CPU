<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cpu_lab_4.MainFrameController">
   <center>
      <AnchorPane prefHeight="486.0" prefWidth="827.0">
          <fx:include fx:id="reg" source="RegFrame.fxml" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
          <fx:include fx:id="mem" source="MemFrame.fxml" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="30" />
         <Label layoutX="627.0" layoutY="395.0" text="Частота появления инструкций" />
         <Label fx:id="cm1" layoutX="613.0" layoutY="412.0" text="init" />
         <Label fx:id="cm2" layoutX="613.0" layoutY="429.0" text="ld" />
         <Label fx:id="cm3" layoutX="613.0" layoutY="446.0" text="add" />
         <Label fx:id="cm4" layoutX="613.0" layoutY="464.0" text="mv" />
         <Label fx:id="cnt1" layoutX="714.0" layoutY="412.0" text="0" />
         <Label fx:id="cnt2" layoutX="714.0" layoutY="429.0" text="0" />
         <Label fx:id="cnt3" layoutX="714.0" layoutY="446.0" text="0" />
         <Label fx:id="cnt4" layoutX="714.0" layoutY="464.0" text="0" />
         <children>
            <ScrollPane prefHeight="486.0" prefWidth="582.0" style="-fx-border-color: black;">
              <content>
                  <GridPane fx:id="allcommands" prefHeight="482.0" prefWidth="578.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="70.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
                     </children>
                  </GridPane>
              </content>
            </ScrollPane>
            <Pane fx:id="panereg" layoutX="582.0" layoutY="2.0" prefHeight="140.0" prefWidth="244.0" />
         </children></AnchorPane>
   </center>
   <bottom>
      <Pane prefHeight="129.0" prefWidth="827.0" style="-fx-border-color: black;" BorderPane.alignment="CENTER">
         <children>
            <Button layoutX="10.0" layoutY="15.0" mnemonicParsing="false" onAction="#addCommand" prefHeight="48.0" prefWidth="166.0" text="Добавить команду" />
            <Button layoutX="310.0" layoutY="41.0" mnemonicParsing="false" prefHeight="53.0" prefWidth="168.0" text="Сбросить выполнение" />
            <Button layoutX="566.0" layoutY="41.0" mnemonicParsing="false" onAction="#runCommand" prefHeight="55.0" prefWidth="182.0" text="Выполнить инструкцию" />
            <TextField fx:id="Fcom" layoutX="10.0" layoutY="69.0" prefHeight="25.0" prefWidth="167.0" />
         </children>
      </Pane>
   </bottom>
</BorderPane>
